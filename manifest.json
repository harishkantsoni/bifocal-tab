{
  "manifest_version": 3,
  "name": "Focus New Tab",
  "version": "1.0.0",
  "description": "Split new tab: Google search on one half, drag-and-drop speed dials and groups on the other.",
  "minimum_chrome_version": "108",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "favicon",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "*://*.google.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "frame_unblock",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
